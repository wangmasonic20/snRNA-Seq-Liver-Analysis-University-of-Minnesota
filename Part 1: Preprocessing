# =========================
# Normalize + variable genes
# =========================

c.list <- lapply(
  X = c.list,
  FUN = function(x) {
    x <- NormalizeData(x)
    x <- FindVariableFeatures(x)
    return(x)
  }
)


features <- SelectIntegrationFeatures(object.list = c.list)
immune.anchors <- FindIntegrationAnchors(object.list = c.list, anchor.features = features, reference = 3)
immune.combined <- IntegrateData(anchorset = immune.anchors)

immune.combined@active.assay = "RNA"
immune.combined = JoinLayers(immune.combined)
